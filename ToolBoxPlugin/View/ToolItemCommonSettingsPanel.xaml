<UserControl x:Class="ToolBox.View.ToolItemCommonSettingsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:tbRow="clr-namespace:ToolBox.Controls"
             xmlns:toolbox="clr-namespace:ToolBox"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:YukkuriMovieMaker.Controls;assembly=YukkuriMovieMaker.Controls"
             xmlns:tbControls="clr-namespace:ToolBox.Controls"
             xmlns:settings="clr-namespace:ToolBox.Settings"
             xmlns:vm="clr-namespace:ToolBox.ViewModel"
             xmlns:media="clr-namespace:System.Windows.Media;assembly=PresentationCore"
             mc:Ignorable="d"
             d:DesignWidth="300"
             d:DataContext="{d:DesignInstance Type=vm:ItemEntryViewModelBase}">

    <UserControl.Resources>
        <Style x:Key="VisibleWhenCustomAppearance" TargetType="FrameworkElement">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding SettingsInstance.UseCustomAppearance}" Value="True">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="VisibleWhenImage" TargetType="FrameworkElement">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding SettingsInstance.DisplayMode}" Value="{x:Static settings:ToolItemDisplayMode.Image}">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <StackPanel IsEnabled="{Binding HasInstances}">
        <StackPanel>

            <Expander Style="{DynamicResource ToolBoxSettingsSection}">
                <Expander.Header>
                    <TextBlock Text="{x:Static toolbox:Texts.ItemCommonDisplaySection}" FontWeight="SemiBold"/>
                </Expander.Header>
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{x:Static toolbox:Texts.ItemCommonDisplayModeLabel}" VerticalAlignment="Center"/>
                        <ComboBox Grid.Column="1" SelectedValue="{Binding SettingsInstance.DisplayMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  SelectedValuePath="Tag"
                                  HorizontalAlignment="Right" VerticalContentAlignment="Center" Width="180" Height="24" >
                            <ComboBoxItem Content="{x:Static toolbox:Texts.DisplayModeIcon}" Tag="{x:Static settings:ToolItemDisplayMode.Icon}"/>
                            <ComboBoxItem Content="{x:Static toolbox:Texts.DisplayModeText}" Tag="{x:Static settings:ToolItemDisplayMode.Text}"/>
                            <ComboBoxItem Content="{x:Static toolbox:Texts.DisplayModeImage}" Tag="{x:Static settings:ToolItemDisplayMode.Image}"/>
                        </ComboBox>
                    </Grid>

                    <tbRow:SettingsRow Label="{x:Static toolbox:Texts.ItemCommonImageFileLabel}" Style="{StaticResource VisibleWhenImage}">
                        <controls:FileSelector Value="{Binding SettingsInstance.CustomImagePath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        Filter="{x:Static toolbox:Texts.FilterImageFiles}"
                        HorizontalAlignment="Right" Width="180" Height="24" VerticalContentAlignment="Center"  />
                    </tbRow:SettingsRow>

                    <Grid Style="{StaticResource VisibleWhenImage}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{x:Static toolbox:Texts.ItemCommonImageFitLabel}" VerticalAlignment="Center"/>
                        <ComboBox Grid.Column="1" SelectedValue="{Binding SettingsInstance.ImageStretch, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  SelectedValuePath="Tag"
                                  HorizontalAlignment="Right" VerticalContentAlignment="Center" Width="180" Height="24">
                            <ComboBoxItem Content="{x:Static toolbox:Texts.ImageFitUniform}" Tag="{x:Static media:Stretch.Uniform}"/>
                            <ComboBoxItem Content="{x:Static toolbox:Texts.ImageFitFill}" Tag="{x:Static media:Stretch.Fill}"/>
                            <ComboBoxItem Content="{x:Static toolbox:Texts.ImageFitUniformToFill}" Tag="{x:Static media:Stretch.UniformToFill}"/>
                        </ComboBox>
                    </Grid>

                    <tbRow:SettingsRow Label="{x:Static toolbox:Texts.ItemCommonButtonLabel}">
                        <TextBox Text="{Binding SettingsInstance.Label, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        HorizontalAlignment="Right" VerticalContentAlignment="Center" Width="180" Height="24"/>
                    </tbRow:SettingsRow>
                </StackPanel>
            </Expander>

            <Expander Style="{DynamicResource ToolBoxSettingsSection}">
                <Expander.Header>
                    <TextBlock Text="{x:Static toolbox:Texts.ItemCommonColorSection}" FontWeight="SemiBold"/>
                </Expander.Header>
                <StackPanel>
                    <tbRow:SettingsRow Label="{x:Static toolbox:Texts.ItemCommonUseCustomColor}">
                        <controls:ToggleSlider Value="{Binding SettingsInstance.UseCustomAppearance, Mode=TwoWay}"
                        HorizontalAlignment="Right"/>
                    </tbRow:SettingsRow>

                    <tbRow:SettingsRow Label="{x:Static toolbox:Texts.ItemCommonBackground}" Style="{StaticResource VisibleWhenCustomAppearance}">
                        <controls:ColorPicker Value="{Binding SettingsInstance.BackgroundColor, Mode=TwoWay}"
                        HorizontalAlignment="Right" Width="180" Height="24" VerticalContentAlignment="Center"/>
                    </tbRow:SettingsRow>

                    <tbRow:SettingsRow Label="{x:Static toolbox:Texts.ItemCommonBorder}" Style="{StaticResource VisibleWhenCustomAppearance}">
                        <controls:ColorPicker Value="{Binding SettingsInstance.BorderColor, Mode=TwoWay}"
                        HorizontalAlignment="Right" Width="180" Height="24" VerticalContentAlignment="Center"/>
                    </tbRow:SettingsRow>

                    <tbRow:SettingsRow Label="{x:Static toolbox:Texts.ItemCommonForeground}" Style="{StaticResource VisibleWhenCustomAppearance}">
                        <controls:ColorPicker Value="{Binding SettingsInstance.ForegroundColor, Mode=TwoWay}"
                        HorizontalAlignment="Right" Width="180" Height="24" VerticalContentAlignment="Center"/>
                    </tbRow:SettingsRow>

                    <tbRow:SettingsRow Label="{x:Static toolbox:Texts.ItemCommonBorderThickness}" Style="{StaticResource VisibleWhenCustomAppearance}">
                        <controls:TextBoxSlider Value="{Binding SettingsInstance.BorderThickness, Mode=TwoWay}"
                        DefaultValue="1" StringFormat="F0" Unit="px"
                        Min="0" Max="8" DefaultMin="0" DefaultMax="8" Delta="1"
                        HorizontalAlignment="Right" Width="180" Height="24" VerticalContentAlignment="Center"/>
                    </tbRow:SettingsRow>

                    <tbRow:SettingsRow Label="{x:Static toolbox:Texts.ItemCommonCornerRadius}" Margin="0,0,0,8" Style="{StaticResource VisibleWhenCustomAppearance}">
                        <controls:TextBoxSlider Value="{Binding SettingsInstance.CornerRadius, Mode=TwoWay}"
                        DefaultValue="0" StringFormat="F0" Unit="px"
                        Min="0" Max="20" DefaultMin="0" DefaultMax="20" Delta="1"
                        HorizontalAlignment="Right" Width="180" Height="24" VerticalContentAlignment="Center"/>
                    </tbRow:SettingsRow>

                    <Button Content="{x:Static toolbox:Texts.ItemCommonResetColors}"
                            Command="{Binding ResetAppearanceCommand}"
                            HorizontalAlignment="Right"
                            Padding="8,3"/>
                </StackPanel>
            </Expander>

            <StackPanel>
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SettingsInstance.IsInvokable}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>

                <Expander Style="{DynamicResource ToolBoxSettingsSection}">
                    <Expander.Header>
                        <TextBlock Text="{x:Static toolbox:Texts.ItemCommonHotkey}" FontWeight="SemiBold"/>
                    </Expander.Header>
                    <StackPanel>
                        <tbRow:SettingsRow Label="{x:Static toolbox:Texts.ItemCommonHotkey}" Margin="0,0,0,4">
                            <tbControls:HotkeyBox Gesture="{Binding SettingsInstance.HotkeyGesture, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            HorizontalAlignment="Right" Width="180" Height="24" VerticalContentAlignment="Center"/>
                        </tbRow:SettingsRow>

                        <TextBlock Text="{Binding HotkeyConflictMessage}"
                                   FontSize="10" TextWrapping="Wrap" Margin="0,0,0,6"
                                   Foreground="{DynamicResource {x:Static SystemColors.HotTrackBrushKey}}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasHotkeyConflict}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <TextBlock Text="{x:Static toolbox:Texts.ItemCommonHotkeyHint}"
                                   FontSize="10" TextWrapping="Wrap"
                                   Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"/>
                    </StackPanel>
                </Expander>
            </StackPanel>
        </StackPanel>
    </StackPanel>
</UserControl>
