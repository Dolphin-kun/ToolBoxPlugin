<UserControl x:Class="ToolBox.View.ToolItemCommonSettingsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:YukkuriMovieMaker.Controls;assembly=YukkuriMovieMaker.Controls"
             xmlns:tbControls="clr-namespace:ToolBox.Controls"
             xmlns:settings="clr-namespace:ToolBox.Settings"
             xmlns:vm="clr-namespace:ToolBox.ViewModel"
             mc:Ignorable="d"
             d:DesignWidth="300"
             d:DataContext="{d:DesignInstance Type=vm:ItemEntryViewModelBase}">

    <UserControl.Resources>
        <Style x:Key="VisibleWhenCustomAppearance" TargetType="FrameworkElement">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding SettingsInstance.UseCustomAppearance}" Value="True">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <StackPanel IsEnabled="{Binding HasInstances}">
        <StackPanel>

            <Expander Style="{DynamicResource ToolBoxSettingsSection}">
                <Expander.Header>
                    <TextBlock Text="表示" FontWeight="SemiBold"/>
                </Expander.Header>
                <StackPanel>
                    <Grid>
                        <TextBlock Text="表示設定" VerticalAlignment="Center"/>
                        <ComboBox SelectedValue="{Binding SettingsInstance.DisplayMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  SelectedValuePath="Tag"
                                  HorizontalAlignment="Right" VerticalContentAlignment="Center" Width="180" Height="24" >
                            <ComboBoxItem Content="アイコン" Tag="{x:Static settings:ToolItemDisplayMode.Icon}"/>
                            <ComboBoxItem Content="テキスト" Tag="{x:Static settings:ToolItemDisplayMode.Text}"/>
                            <ComboBoxItem Content="画像" Tag="{x:Static settings:ToolItemDisplayMode.Image}"/>
                        </ComboBox>
                    </Grid>

                    <Grid>
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SettingsInstance.DisplayMode}" Value="{x:Static settings:ToolItemDisplayMode.Image}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <TextBlock Text="画像ファイル" VerticalAlignment="Center" />
                        <controls:FileSelector Value="{Binding SettingsInstance.CustomImagePath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                               Filter="画像ファイル|*.png;*.jpg;*.jpeg;*.bmp|すべてのファイル|*.*"
                                               HorizontalAlignment="Right" Width="180" Height="24" VerticalContentAlignment="Center"  />
                    </Grid>

                    <Grid>
                        <TextBlock Text="ボタンのラベル" VerticalAlignment="Center"/>
                        <TextBox Text="{Binding SettingsInstance.Label, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 HorizontalAlignment="Right" VerticalContentAlignment="Center" Width="180" Height="24"/>
                    </Grid>
                </StackPanel>
            </Expander>

            <Expander Style="{DynamicResource ToolBoxSettingsSection}">
                <Expander.Header>
                    <TextBlock Text="配色" FontWeight="SemiBold"/>
                </Expander.Header>
                <StackPanel>
                    <Grid>
                        <TextBlock Text="配色を変更する" VerticalAlignment="Center"/>
                        <controls:ToggleSlider Value="{Binding SettingsInstance.UseCustomAppearance, Mode=TwoWay}"
                                               HorizontalAlignment="Right"/>
                    </Grid>

                    <Grid Style="{StaticResource VisibleWhenCustomAppearance}">
                        <TextBlock Text="背景色" VerticalAlignment="Center"/>
                        <controls:ColorPicker Value="{Binding SettingsInstance.BackgroundColor, Mode=TwoWay}"
                                              HorizontalAlignment="Right" Width="180" Height="24" VerticalContentAlignment="Center"/>
                    </Grid>

                    <Grid Style="{StaticResource VisibleWhenCustomAppearance}">
                        <TextBlock Text="枠の色" VerticalAlignment="Center"/>
                        <controls:ColorPicker Value="{Binding SettingsInstance.BorderColor, Mode=TwoWay}"
                                              HorizontalAlignment="Right" Width="180" Height="24" VerticalContentAlignment="Center"/>
                    </Grid>

                    <Grid Style="{StaticResource VisibleWhenCustomAppearance}">
                        <TextBlock Text="アイコン・文字の色" VerticalAlignment="Center"/>
                        <controls:ColorPicker Value="{Binding SettingsInstance.ForegroundColor, Mode=TwoWay}"
                                              HorizontalAlignment="Right" Width="180" Height="24" VerticalContentAlignment="Center"/>
                    </Grid>

                    <Grid Style="{StaticResource VisibleWhenCustomAppearance}">
                        <TextBlock Text="枠の太さ" VerticalAlignment="Center"/>
                        <controls:TextBoxSlider Value="{Binding SettingsInstance.BorderThickness, Mode=TwoWay}"
                                                DefaultValue="1" StringFormat="F0" Unit="px"
                                                Min="0" Max="8" DefaultMin="0" DefaultMax="8" Delta="1"
                                                HorizontalAlignment="Right" Width="180" Height="24" VerticalContentAlignment="Center"/>
                    </Grid>

                    <Grid Margin="0,0,0,8" Style="{StaticResource VisibleWhenCustomAppearance}">
                        <TextBlock Text="角の丸み" VerticalAlignment="Center"/>
                        <controls:TextBoxSlider Value="{Binding SettingsInstance.CornerRadius, Mode=TwoWay}"
                                                DefaultValue="0" StringFormat="F0" Unit="px"
                                                Min="0" Max="20" DefaultMin="0" DefaultMax="20" Delta="1"
                                                HorizontalAlignment="Right" Width="180" Height="24" VerticalContentAlignment="Center"/>
                    </Grid>

                    <Button Content="配色をリセット"
                            Command="{Binding ResetAppearanceCommand}"
                            HorizontalAlignment="Right"
                            Padding="8,3"/>
                </StackPanel>
            </Expander>

            <StackPanel>
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SettingsInstance.IsInvokable}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>

                <Expander Style="{DynamicResource ToolBoxSettingsSection}">
                    <Expander.Header>
                        <TextBlock Text="ホットキー" FontWeight="SemiBold"/>
                    </Expander.Header>
                    <StackPanel>
                        <Grid Margin="0,0,0,4">
                            <TextBlock Text="ホットキー" VerticalAlignment="Center"/>
                            <tbControls:HotkeyBox Gesture="{Binding SettingsInstance.HotkeyGesture, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  HorizontalAlignment="Right" Width="180" Height="24" VerticalContentAlignment="Center"/>
                        </Grid>

                        <TextBlock Text="{Binding HotkeyConflictMessage}"
                                   FontSize="10" TextWrapping="Wrap" Margin="0,0,0,6"
                                   Foreground="{DynamicResource {x:Static SystemColors.HotTrackBrushKey}}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasHotkeyConflict}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <TextBlock Text="欄を選んでキーを押すと割り当てます。Esc で解除します。文字入力と区別するため、Ctrl か Alt を含む組み合わせだけ設定できます。アプリが前面にあるときだけ働きます。"
                                   FontSize="10" TextWrapping="Wrap"
                                   Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"/>
                    </StackPanel>
                </Expander>
            </StackPanel>
        </StackPanel>
    </StackPanel>
</UserControl>
