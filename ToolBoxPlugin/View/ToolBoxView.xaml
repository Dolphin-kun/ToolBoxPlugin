<UserControl x:Class="ToolBox.View.ToolBoxView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:toolbox="clr-namespace:ToolBox"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:ToolBox.ViewModel"
             xmlns:controls="clr-namespace:ToolBox.Controls"
             xmlns:view="clr-namespace:ToolBox.View"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:ToolBoxViewModel}"
             d:DesignHeight="450" d:DesignWidth="800">

    <Grid Background="Transparent">

        <Grid Background="Transparent">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsSettingsVisible}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <Grid.ContextMenu>
                <ContextMenu Closed="OnPanelContextMenuClosed" Opened="OnPanelContextMenuOpened">
                    <MenuItem Header="{x:Static toolbox:Texts.PanelUndoLayout}" InputGestureText="{x:Static toolbox:Texts.PanelUndoGesture}"
                              Command="{Binding UndoLayoutCommand}" />
                    <MenuItem Header="{x:Static toolbox:Texts.PanelRedoLayout}" InputGestureText="{x:Static toolbox:Texts.PanelRedoGesture}"
                              Command="{Binding RedoLayoutCommand}" />
                    <Separator />
                    <MenuItem x:Name="PasteItemMenuItem" Header="{x:Static toolbox:Texts.PanelPasteItem}" Click="OnPasteItemClick" />
                    <Separator />
                    <MenuItem Header="{x:Static toolbox:Texts.PanelAdd}" Click="OnAddPanelClick" />
                    <MenuItem Header="{x:Static toolbox:Texts.PanelDuplicate}" Click="OnDuplicatePanelClick" />
                    <MenuItem Header="{x:Static toolbox:Texts.PanelRenameTitle}" Click="OnRenamePanelClick" />
                    <Separator />
                    <MenuItem Header="{x:Static toolbox:Texts.CommonSettings}" Click="OnSettingsClick" />
                </ContextMenu>
            </Grid.ContextMenu>

            <controls:DropGrid x:Name="DropGrid"
                                RowCount="{Binding Panel.GridRowCount}" ColumnCount="{Binding Panel.GridColumnCount}"
                                CellSize="{Binding ToolBoxSettings.CellSize}" CellMargin="{Binding ToolBoxSettings.CellMargin}"
                                ShowHighlight="{Binding ToolBoxSettings.ShowHighlight}"
                                HighlightColor="{Binding ToolBoxSettings.HighlightColor}"
                                ShowCellBorders="{Binding ToolBoxSettings.ShowGridLines}"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top" />

            <controls:DraggableCanvas ItemsSource="{Binding Panel.Items}"
                                       DropGrid="{Binding ElementName=DropGrid}"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Top">
                <controls:DraggableCanvas.Template>
                    <ControlTemplate TargetType="{x:Type controls:DraggableCanvas}">
                        <ItemsPresenter />
                    </ControlTemplate>
                </controls:DraggableCanvas.Template>
                <controls:DraggableCanvas.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Canvas Background="Transparent" />
                    </ItemsPanelTemplate>
                </controls:DraggableCanvas.ItemsPanel>
            </controls:DraggableCanvas>

            <controls:DropGridHighlightOverlay DropGrid="{Binding ElementName=DropGrid}"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Top"
                                                IsHitTestVisible="False" />
        </Grid>

        <view:ToolBoxSettingsPanel 
            DataContext="{Binding SettingsViewModel}"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch">
            <view:ToolBoxSettingsPanel.Style>
                <Style TargetType="view:ToolBoxSettingsPanel">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding DataContext.IsSettingsVisible, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </view:ToolBoxSettingsPanel.Style>
        </view:ToolBoxSettingsPanel>
    </Grid>
</UserControl>
