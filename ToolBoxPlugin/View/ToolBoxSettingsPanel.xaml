<UserControl x:Class="ToolBox.View.ToolBoxSettingsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:ToolBox.ViewModel"
             xmlns:view="clr-namespace:ToolBox.View"
             xmlns:settingsView="clr-namespace:ToolBox.View.Settings"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:ToolBoxSettingsViewModel}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ヘッダー -->
        <Grid Grid.Row="0" Margin="8,6,8,6">
            <TextBlock Text="ツールボックスの設定" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <Button Content="✕"
                    Command="{Binding CloseCommand}"
                    HorizontalAlignment="Right"
                    Width="20" Height="20"
                    Background="Transparent"
                    BorderThickness="0"
                    FontWeight="Bold"
                    VerticalAlignment="Center"/>
        </Grid>

        <Border Grid.Row="0" VerticalAlignment="Bottom"
                BorderThickness="0,0,0,1"
                BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="160" MinWidth="100" MaxWidth="220"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左ペイン -->
            <view:SettingsNavigationPane Grid.Column="0" />

            <!-- スプリッター -->
            <GridSplitter Grid.Column="1" Width="1"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Stretch"
                          Background="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"/>

            <!-- 右ペイン: SelectedDetail の型ごとに対応する View を表示する -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <ContentControl Content="{Binding SelectedDetail}" Margin="8">
                    <ContentControl.Resources>
                        <DataTemplate DataType="{x:Type vm:BasicSettingsViewModel}">
                            <settingsView:BasicSettingsView />
                        </DataTemplate>

                        <DataTemplate DataType="{x:Type vm:GeneralSettingsViewModel}">
                            <settingsView:GridSettingsView />
                        </DataTemplate>

                        <DataTemplate DataType="{x:Type vm:AddonSettingsViewModel}">
                            <settingsView:AddonSettingsView />
                        </DataTemplate>

                        <DataTemplate DataType="{x:Type vm:ToolItemEntryViewModel}">
                            <settingsView:ToolItemSettingsView />
                        </DataTemplate>

                        <DataTemplate DataType="{x:Type vm:ShortcutEntryViewModel}">
                            <settingsView:ShortcutSettingsView />
                        </DataTemplate>

                        <DataTemplate DataType="{x:Type vm:ShortcutsGroupViewModel}">
                            <settingsView:ShortcutsOverviewView />
                        </DataTemplate>
                    </ContentControl.Resources>
                </ContentControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
