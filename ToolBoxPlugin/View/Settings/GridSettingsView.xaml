<UserControl x:Class="ToolBox.View.Settings.GridSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:YukkuriMovieMaker.Controls;assembly=YukkuriMovieMaker.Controls"
             xmlns:vm="clr-namespace:ToolBox.ViewModel"
             xmlns:settings="clr-namespace:ToolBox.Settings"
             mc:Ignorable="d"
             d:DesignWidth="300"
             d:DataContext="{d:DesignInstance Type=vm:GeneralSettingsViewModel}">

    <UserControl.Resources>
        <Style x:Key="VisibleWhenAuto" TargetType="Grid">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Settings.GridAdjustMode}" Value="{x:Static settings:GridAdjustMode.Auto}">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="VisibleWhenManual" TargetType="Grid">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Settings.GridAdjustMode}" Value="{x:Static settings:GridAdjustMode.Manual}">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <TextBlock Text="グリッドの設定"
                   FontWeight="SemiBold" FontSize="13"
                   Margin="0,0,0,8"/>

        <Border Style="{DynamicResource SettingsHeaderSeparator}"/>

        <Grid>
            <TextBlock Text="グリッドの調整" VerticalAlignment="Center"/>
            <ComboBox SelectedValue="{Binding Settings.GridAdjustMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                      SelectedValuePath="Tag"
                      HorizontalAlignment="Right" Width="200" Height="24" VerticalContentAlignment="Center">
                <ComboBoxItem Content="自動" Tag="{x:Static settings:GridAdjustMode.Auto}"/>
                <ComboBoxItem Content="指定" Tag="{x:Static settings:GridAdjustMode.Manual}"/>
            </ComboBox>
        </Grid>

        <Grid Style="{StaticResource VisibleWhenAuto}">
            <TextBlock Text="サイズ" VerticalAlignment="Center"/>
            <controls:ToggleSlider Value="{Binding Settings.AutoFitSize, Mode=TwoWay}"
                                   HorizontalAlignment="Right"/>
        </Grid>

        <Grid Style="{StaticResource VisibleWhenAuto}">
            <TextBlock Text="配置" VerticalAlignment="Center"/>
            <controls:ToggleSlider Value="{Binding Settings.AutoFitLayout, Mode=TwoWay}"
                                   HorizontalAlignment="Right"/>
        </Grid>

        <Grid Style="{StaticResource VisibleWhenManual}">
            <TextBlock Text="縦" VerticalAlignment="Center"/>
            <controls:TextBoxSlider Value="{Binding Panel.GridRowCount, Mode=TwoWay}"
                                    DefaultValue="6" StringFormat="F0" IsUnitVisible="False"
                                    Min="1" Max="50" DefaultMin="1" DefaultMax="50" Delta="1"
                                    HorizontalAlignment="Right" Width="200" Height="24" VerticalContentAlignment="Center"/>
        </Grid>

        <Grid Style="{StaticResource VisibleWhenManual}">
            <TextBlock Text="横" VerticalAlignment="Center"/>
            <controls:TextBoxSlider Value="{Binding Panel.GridColumnCount, Mode=TwoWay}"
                                    DefaultValue="6" StringFormat="F0" IsUnitVisible="False"
                                    Min="1" Max="50" DefaultMin="1" DefaultMax="50" Delta="1"
                                    HorizontalAlignment="Right" Width="200" Height="24" VerticalContentAlignment="Center"/>
        </Grid>

        <Grid>
            <TextBlock Text="セルの枠線を常に表示" VerticalAlignment="Center"/>
            <controls:ToggleSlider Value="{Binding Settings.ShowGridLines, Mode=TwoWay}"
                                   HorizontalAlignment="Right"/>
        </Grid>

        <Grid>
            <TextBlock Text="ハイライトを表示" VerticalAlignment="Center" />
            <controls:ToggleSlider Value="{Binding Settings.ShowHighlight, Mode=TwoWay}"
                                   HorizontalAlignment="Right"/>
        </Grid>

        <Grid Margin="0,0,0,8">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Settings.ShowHighlight}" Value="False">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <TextBlock Text="ハイライト色" VerticalAlignment="Center"/>
            <controls:ColorPicker Value="{Binding Settings.HighlightColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  HorizontalAlignment="Right" Width="200" Height="24" VerticalContentAlignment="Center"/>
        </Grid>
    </StackPanel>
</UserControl>
