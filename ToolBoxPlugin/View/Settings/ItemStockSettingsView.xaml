<UserControl x:Class="ToolBox.View.Settings.ItemStockSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:toolbox="clr-namespace:ToolBox"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:tbControls="clr-namespace:ToolBox.Controls"
             xmlns:commons="clr-namespace:ToolBox.Commons"
             xmlns:icons="clr-namespace:YukkuriMovieMaker.Resources.Icons;assembly=YukkuriMovieMaker.Plugin"
             xmlns:theme="clr-namespace:YukkuriMovieMaker.Theme;assembly=YukkuriMovieMaker.Plugin"
             xmlns:settings="clr-namespace:ToolBox.Settings"
             xmlns:vm="clr-namespace:ToolBox.ViewModel"
             mc:Ignorable="d"
             d:DesignWidth="300"
             d:DataContext="{d:DesignInstance Type=vm:ItemStockSettingsViewModel}">

    <UserControl.Resources>
            <DataTemplate x:Key="StockTemplate" DataType="{x:Type settings:ItemStockEntry}">
                <Grid Background="Transparent">
                    <Grid.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="{x:Static toolbox:Texts.CommonRename}" Click="OnRenameClick"/>
                            <MenuItem Header="{x:Static toolbox:Texts.CommonDelete}" Click="OnRemoveClick"/>
                        </ContextMenu>
                    </Grid.ContextMenu>

                    <TextBlock TextTrimming="CharacterEllipsis" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                        <Run Text="{Binding DisplayLabel, Mode=OneWay}"/>
                        <Run Text="{Binding Summary, Mode=OneWay}"
                             Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"/>
                    </TextBlock>

                    <TextBox Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             IsVisibleChanged="OnRenameBoxVisibleChanged"
                             KeyDown="OnRenameBoxKeyDown"
                             LostFocus="OnRenameBoxLostFocus" Height="24" VerticalContentAlignment="Center">
                        <TextBox.Style>
                            <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>
                </Grid>
            </DataTemplate>
    </UserControl.Resources>

    <StackPanel>
        <TextBlock Text="{x:Static toolbox:Texts.ItemStockTitle}"
                   FontWeight="SemiBold" FontSize="13"/>
        <TextBlock Text="{x:Static toolbox:Texts.ItemStockHint}"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"/>
        <Border Style="{DynamicResource SettingsHeaderSeparator}"/>

        <tbControls:ListPanel x:Name="StockList"/>
    </StackPanel>
</UserControl>
