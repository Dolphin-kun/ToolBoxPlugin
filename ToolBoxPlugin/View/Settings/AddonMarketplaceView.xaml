<UserControl x:Class="ToolBox.View.Settings.AddonMarketplaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:toolbox="clr-namespace:ToolBox"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:ToolBox.ViewModel"
             mc:Ignorable="d"
             d:DesignWidth="300"
             d:DataContext="{d:DesignInstance Type=vm:AddonMarketplaceViewModel}">

    <StackPanel>
        <TextBlock Text="{x:Static toolbox:Texts.AddonMarketplaceTitle}"
                   FontWeight="SemiBold" FontSize="13"
                   Margin="0,0,0,10"/>

        <TextBlock TextWrapping="Wrap" Margin="0,0,0,8"
                   Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}">
            <Run Text="{x:Static toolbox:Texts.AddonMarketplaceHintPrefix}"/>
            <Run Text=" ymm4-toolbox-addon " FontWeight="SemiBold"/>
            <Run Text="{x:Static toolbox:Texts.AddonMarketplaceHintSuffix}"/>
        </TextBlock>

        <Border Style="{DynamicResource SettingsHeaderSeparator}"/>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <Button Content="{x:Static toolbox:Texts.AddonMarketplaceRefresh}" Command="{Binding RefreshCommand}"
                    Padding="10,3"/>
        </StackPanel>

        <TextBlock Text="{Binding StatusMessage}"
                   TextWrapping="Wrap" Margin="0,0,0,10"
                   Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"/>

        <ItemsControl ItemsSource="{Binding Addons}" IsEnabled="{Binding IsIdle}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border BorderThickness="1"
                            BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                            Padding="8"
                            Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12"/>
                                    <TextBlock Text="{x:Static toolbox:Texts.AddonMarketplaceInstalled}" FontSize="10" Margin="6,0,0,0" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsInstalled}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                    <TextBlock Text="{Binding Owner}"
                                               Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"/>
                                    <TextBlock Text="{Binding StarsText}" Margin="8,0,0,0"
                                               Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"/>
                                    <TextBlock Text="{Binding UpdatedText}" Margin="8,0,0,0"
                                               Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"/>
                                </StackPanel>

                                <TextBlock Text="{Binding Description}"
                                           Margin="0,4,0,0" TextWrapping="Wrap"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" VerticalAlignment="Top">
                                <Button Content="{x:Static toolbox:Texts.AddonMarketplaceInstall}"
                                        Command="{Binding DataContext.InstallCommand,
                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Padding="10,3"/>
                                <Button Content="GitHub"
                                        Command="{Binding DataContext.OpenRepositoryCommand,
                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Padding="10,3" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
