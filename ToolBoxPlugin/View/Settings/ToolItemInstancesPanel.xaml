<UserControl x:Class="ToolBox.View.Settings.ToolItemInstancesPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:YukkuriMovieMaker.Controls;assembly=YukkuriMovieMaker.Controls"
             xmlns:icons="clr-namespace:YukkuriMovieMaker.Resources.Icons;assembly=YukkuriMovieMaker.Plugin"
             xmlns:theme="clr-namespace:YukkuriMovieMaker.Theme;assembly=YukkuriMovieMaker.Plugin"
             xmlns:tbCommons="clr-namespace:ToolBox.Commons"
             xmlns:tbControls="clr-namespace:ToolBox.Controls"
             xmlns:vm="clr-namespace:ToolBox.ViewModel"
             mc:Ignorable="d"
             d:DesignWidth="300"
             d:DataContext="{d:DesignInstance Type=vm:ItemEntryViewModelBase}">

    <Expander IsExpanded="True" Style="{DynamicResource ToolBoxSettingsSection}">
        <Expander.Header>
            <TextBlock FontSize="11" FontWeight="SemiBold">
                <Run Text="アイテム"/>
                <Run Text="{Binding InstanceCount, Mode=OneWay, StringFormat=({0})}"
                     Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"/>
            </TextBlock>
        </Expander.Header>

        <StackPanel>
            <Grid Margin="0,0,0,6">
                <TextBlock Text="ツールボックスに表示" VerticalAlignment="Center" FontSize="11"/>
                <controls:ToggleSlider Value="{Binding IsVisible, Mode=TwoWay}"
                                       HorizontalAlignment="Right" Width="40"/>
            </Grid>

            <ListBox tbControls:ScrollBubbling.IsEnabled="True"
                     ItemsSource="{Binding Instances}"
                     SelectedItem="{Binding SelectedInstance, Mode=TwoWay}"
                     BorderThickness="0" Background="Transparent"
                     HorizontalContentAlignment="Stretch"
                     MaxHeight="140"
                     Margin="0,0,0,4">
                <ListBox.Style>
                    <Style TargetType="ListBox">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasInstances}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ListBox.Style>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" FontSize="11" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis">
                                <Run Text="{Binding InstanceSummary, Mode=OneWay}"/>
                                <Run Text="{Binding Position, Mode=OneWay}"
                                     Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"/>
                            </TextBlock>

                            <Button Grid.Column="1"
                                    Command="{Binding DataContext.RemoveInstanceCommand,
                                              RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"
                                    ToolTip="この配置を取り除く"
                                    Width="20" Height="20" Padding="0"
                                    Background="Transparent" BorderThickness="0">
                                <tbCommons:IconControl IconData="{x:Static icons:IconKeys.Delete}"
                                                       Foreground="{DynamicResource {x:Static theme:YMM4Colors.IconBrushKey}}"
                                                       Width="12" Height="12"/>
                            </Button>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Button Command="{Binding AddInstanceCommand}"
                    ToolTip="このアイテムをもう 1 つ追加"
                    HorizontalAlignment="Left"
                    Width="24" Height="24" Padding="0">
                <tbCommons:IconControl IconData="{x:Static icons:IconKeys.PlusThick}"
                                       Foreground="{DynamicResource {x:Static theme:YMM4Colors.IconBrushKey}}"
                                       Width="15" Height="15"/>
            </Button>
        </StackPanel>
    </Expander>
</UserControl>
