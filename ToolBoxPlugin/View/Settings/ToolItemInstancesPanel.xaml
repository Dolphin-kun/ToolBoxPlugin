<UserControl x:Class="ToolBox.View.Settings.ToolItemInstancesPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ymmControls="clr-namespace:YukkuriMovieMaker.Controls;assembly=YukkuriMovieMaker.Plugin"
             xmlns:controls="clr-namespace:YukkuriMovieMaker.Controls;assembly=YukkuriMovieMaker.Controls"
             xmlns:tbControls="clr-namespace:ToolBox.Controls"
             xmlns:vm="clr-namespace:ToolBox.ViewModel"
             mc:Ignorable="d"
             d:DesignWidth="300"
             d:DataContext="{d:DesignInstance Type=vm:ItemEntryViewModelBase}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <DataTemplate x:Key="InstanceTemplate">
            <TextBlock TextTrimming="CharacterEllipsis">
                <Run Text="{Binding InstanceSummary, Mode=OneWay}"/>
                <Run Text="{Binding Position, Mode=OneWay}"
                     Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"/>
            </TextBlock>
        </DataTemplate>

        <Style x:Key="SingleColumnEditor" TargetType="ymmControls:PropertiesEditor">
            <Style.Resources>
                <Style TargetType="controls:ToggleSlider">
                    <Setter Property="HorizontalAlignment" Value="Right"/>
                </Style>
            </Style.Resources>
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <tbControls:ListPanel x:Name="InstanceList" Margin="0,0,0,8"/>

        <StackPanel Visibility="{Binding HasInstances, Converter={StaticResource BooleanToVisibilityConverter}}">
            <ContentControl Content="{Binding SettingsView}" Margin="0,0,0,8"
                            Visibility="{Binding HasSettingsView, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}"/>

            <ymmControls:PropertiesEditor Target="{Binding SelectedInstance}" Style="{StaticResource SingleColumnEditor}"/>

            <ymmControls:PropertiesEditor Target="{Binding CommonSettings}" Style="{StaticResource SingleColumnEditor}"/>

            <TextBlock Text="{Binding HotkeyConflictMessage}" TextWrapping="Wrap" Margin="0,4,0,0"
                       Foreground="OrangeRed"
                       Visibility="{Binding HasHotkeyConflict, Converter={StaticResource BooleanToVisibilityConverter}}"/>
        </StackPanel>
    </StackPanel>
</UserControl>
