<UserControl x:Class="ToolBox.View.Settings.AddonSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:toolbox="clr-namespace:ToolBox"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:ToolBox.ViewModel"
             xmlns:commons="clr-namespace:ToolBox.Commons"
             xmlns:controls="clr-namespace:YukkuriMovieMaker.Controls;assembly=YukkuriMovieMaker.Controls"
             xmlns:icons="clr-namespace:YukkuriMovieMaker.Resources.Icons;assembly=YukkuriMovieMaker.Plugin"
             xmlns:theme="clr-namespace:YukkuriMovieMaker.Theme;assembly=YukkuriMovieMaker.Plugin"
             mc:Ignorable="d"
             d:DesignWidth="300"
             d:DataContext="{d:DesignInstance Type=vm:AddonSettingsViewModel}">

    <StackPanel>
        <TextBlock Text="{x:Static toolbox:Texts.AddonListTitle}"
                   FontWeight="SemiBold" FontSize="13"
                   Margin="0,0,0,8"/>

        <Border Style="{DynamicResource SettingsHeaderSeparator}"/>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,0">
            <Button Content="{x:Static toolbox:Texts.AddonOpenFolder}" Command="{Binding OpenAddonFolderCommand}"
                    Padding="8,3"/>
            <Button Content="{x:Static toolbox:Texts.AddonReload}" Command="{Binding ReloadCommand}"
                    Padding="8,3"/>
        </StackPanel>

        <TextBlock Text="{x:Static toolbox:Texts.AddonListEmpty}"
                   Margin="0,0,0,10"
                   Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasAddons}" Value="False">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <ItemsControl ItemsSource="{Binding Addons}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border BorderThickness="1"
                            BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                            Padding="10,8"
                            Margin="0,0,0,8"
                            ToolTip="{Binding SourcePath}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,12,0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12"/>
                                    <TextBlock Text="{Binding Version}"
                                               Margin="6,0,0,0"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"/>
                                    <TextBlock Text="{Binding Author}"
                                               Margin="6,0,0,0"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Author}" Value="">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                                <TextBlock Text="{Binding Description}"
                                           Margin="0,3,0,0"
                                           TextWrapping="Wrap">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Description}" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <controls:ToggleSlider Value="{Binding IsEnabled, Mode=TwoWay}"
                                                       ToolTip="{x:Static toolbox:Texts.AddonEnableTip}"
                                                       VerticalAlignment="Center"/>

                                <Button Command="{Binding DataContext.DeleteAddonCommand,
                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        ToolTip="{x:Static toolbox:Texts.AddonDeleteTip}"
                                        Width="24" Height="24"
                                        Padding="0"
                                        VerticalAlignment="Center"
                                        Background="Transparent"
                                        BorderThickness="0">
                                    <commons:IconControl IconData="{x:Static icons:IconKeys.Delete}"
                                                         Foreground="{DynamicResource {x:Static theme:YMM4Colors.IconBrushKey}}"
                                                         Width="14" Height="14"/>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
