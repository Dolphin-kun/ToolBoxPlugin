<UserControl x:Class="ToolBox.View.SettingsNavigationPane"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:tbControls="clr-namespace:ToolBox.Controls"
             xmlns:vm="clr-namespace:ToolBox.ViewModel"
             xmlns:commons="clr-namespace:ToolBox.Commons"
             xmlns:theme="clr-namespace:YukkuriMovieMaker.Theme;assembly=YukkuriMovieMaker.Plugin"
             xmlns:toolbox="clr-namespace:ToolBox"
             mc:Ignorable="d"
             d:DesignWidth="160"
             d:DataContext="{d:DesignInstance Type=vm:ToolBoxSettingsViewModel}">

    <UserControl.Resources>
        <DataTemplate x:Key="LeafSettingsNode">
            <tbControls:AccordionHeader IsChecked="{Binding IsExpanded, Mode=TwoWay}"
                          ShowArrow="False"
                          Command="{Binding DataContext.SelectDetailCommand,
                                    RelativeSource={RelativeSource AncestorType=UserControl}}"
                          CommandParameter="{Binding}">
                <TextBlock Text="{Binding CategoryName}"
                           FontWeight="SemiBold" FontSize="11"/>
            </tbControls:AccordionHeader>
        </DataTemplate>

        <Style x:Key="CollapsibleChildren" TargetType="Grid">
            <Setter Property="Visibility" Value="Visible"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsExpanded}" Value="False">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding HasChildren}" Value="False">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <Style x:Key="HiddenWhileSearching" TargetType="ScrollViewer">
            <Setter Property="Visibility" Value="Visible"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSearching}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <TextBox x:Name="SearchBox"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     Height="24" VerticalContentAlignment="Center"/>
            <TextBlock Text="{x:Static toolbox:Texts.SettingsSearchPlaceholder}"
                       Margin="6,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                       Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding IsSearching, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel>
                <TextBlock Text="{x:Static toolbox:Texts.CommonNotFound}" Margin="4"
                           Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                           Visibility="{Binding HasNoSearchResults, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                <ItemsControl ItemsSource="{Binding SearchResults}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:SettingsSearchResult}">
                            <tbControls:ItemButton Command="{Binding DataContext.SelectDetailCommand,
                                              RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding Target}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <commons:IconControl Grid.Column="0" IconData="{Binding IconPath}"
                                          Foreground="{DynamicResource {x:Static theme:YMM4Colors.IconBrushKey}}"
                                          Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding DisplayName}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding GroupName}" FontSize="10" TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"/>
                                    </StackPanel>
                                </Grid>
                            </tbControls:ItemButton>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Style="{StaticResource HiddenWhileSearching}">
            <ItemsControl ItemsSource="{Binding Groups}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <ContentControl Content="{Binding}">
                            <ContentControl.Resources>
                                <DataTemplate DataType="{x:Type vm:RootCategoryGroupViewModel}">
                                    <StackPanel>
                                        <tbControls:AccordionHeader IsChecked="{Binding IsExpanded, Mode=TwoWay}"
                                                      ShowArrow="{Binding HasChildren}">
                                            <TextBlock Text="{Binding CategoryName}"
                                                       FontWeight="SemiBold" FontSize="12"/>
                                        </tbControls:AccordionHeader>
                                        <Grid Margin="10,0,0,0" Style="{StaticResource CollapsibleChildren}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Width="1" BorderThickness="1,0,0,0"
                                                    BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                                                    Margin="2,0,8,0" HorizontalAlignment="Left" VerticalAlignment="Stretch"/>
                                            <ItemsControl Grid.Column="1" ItemsSource="{Binding SubGroups}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <ContentControl Content="{Binding}" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Grid>
                                    </StackPanel>
                                </DataTemplate>

                                <DataTemplate DataType="{x:Type vm:BasicSettingsViewModel}">
                                    <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource LeafSettingsNode}"/>
                                </DataTemplate>

                                <DataTemplate DataType="{x:Type vm:GeneralSettingsViewModel}">
                                    <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource LeafSettingsNode}"/>
                                </DataTemplate>

                                <DataTemplate DataType="{x:Type vm:LauncherSettingsViewModel}">
                                    <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource LeafSettingsNode}"/>
                                </DataTemplate>

                                <DataTemplate DataType="{x:Type vm:ItemStockSettingsViewModel}">
                                    <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource LeafSettingsNode}"/>
                                </DataTemplate>

                                <DataTemplate DataType="{x:Type vm:AddonSettingsViewModel}">
                                    <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource LeafSettingsNode}"/>
                                </DataTemplate>

                                <DataTemplate DataType="{x:Type vm:AddonMarketplaceViewModel}">
                                    <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource LeafSettingsNode}"/>
                                </DataTemplate>

                                <DataTemplate DataType="{x:Type vm:ToolItemGroupViewModel}">
                                    <StackPanel>
                                        <tbControls:AccordionHeader IsChecked="{Binding IsExpanded, Mode=TwoWay}"
                                                      ShowArrow="{Binding HasChildren}">
                                            <TextBlock Text="{Binding CategoryName}"
                                                       FontWeight="SemiBold" FontSize="11"/>
                                        </tbControls:AccordionHeader>
                                        <Grid Margin="10,0,0,0" Style="{StaticResource CollapsibleChildren}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Width="1" BorderThickness="1,0,0,0"
                                                    BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                                                    Margin="2,0,8,0" HorizontalAlignment="Left" VerticalAlignment="Stretch"/>
                                            <ItemsControl Grid.Column="1" ItemsSource="{Binding Items}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type vm:ToolItemEntryViewModel}">
                                                        <tbControls:ItemButton Command="{Binding DataContext.SelectDetailCommand,
                                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}">
                                                            <StackPanel Orientation="Horizontal">
                                                                <commons:IconControl IconData="{Binding IconPath}"
                                                                      Foreground="{DynamicResource {x:Static theme:YMM4Colors.IconBrushKey}}"
                                                                      Width="14" Height="14" Margin="0,0,6,0"/>
                                                                <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center" FontSize="11"/>
                                                            </StackPanel>
                                                        </tbControls:ItemButton>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Grid>
                                    </StackPanel>
                                </DataTemplate>

                                <DataTemplate DataType="{x:Type vm:ShortcutsGroupViewModel}">
                                    <StackPanel>
                                        <tbControls:AccordionHeader IsChecked="{Binding IsExpanded, Mode=TwoWay}"
                                                      ShowArrow="{Binding HasChildren}"
                                                      Command="{Binding DataContext.SelectDetailCommand,
                                                                RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                      CommandParameter="{Binding}">
                                            <TextBlock Text="{Binding CategoryName}"
                                                       FontWeight="SemiBold" FontSize="11"/>
                                        </tbControls:AccordionHeader>
                                        <Grid Margin="10,0,0,0" Style="{StaticResource CollapsibleChildren}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Width="1" BorderThickness="1,0,0,0"
                                                    BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                                                    Margin="2,0,8,0" HorizontalAlignment="Left" VerticalAlignment="Stretch"/>
                                            <ItemsControl Grid.Column="1" ItemsSource="{Binding Shortcuts}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type vm:ShortcutEntryViewModel}">
                                                        <tbControls:ItemButton Command="{Binding DataContext.SelectDetailCommand,
                                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}">
                                                            <StackPanel Orientation="Horizontal">
                                                                <commons:IconControl IconData="{Binding IconPath}"
                                                                      Foreground="{DynamicResource {x:Static theme:YMM4Colors.IconBrushKey}}"
                                                                      Width="14" Height="14" Margin="0,0,6,0"/>
                                                                <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center" FontSize="11"/>
                                                            </StackPanel>
                                                        </tbControls:ItemButton>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Grid>
                                    </StackPanel>
                                </DataTemplate>
                            </ContentControl.Resources>
                        </ContentControl>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
