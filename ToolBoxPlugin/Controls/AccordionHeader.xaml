<ToggleButton x:Class="ToolBox.Controls.AccordionHeader"
              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:local="clr-namespace:ToolBox.Controls"
              xmlns:commons="clr-namespace:ToolBox.Commons"
              xmlns:icons="clr-namespace:YukkuriMovieMaker.Resources.Icons;assembly=YukkuriMovieMaker.Plugin"
              HorizontalAlignment="Stretch"
              HorizontalContentAlignment="Left"
              Background="Transparent"
              BorderThickness="0"
              Padding="4,5,4,5"
              Cursor="Hand"
              Style="{DynamicResource {x:Static ToolBar.ToggleButtonStyleKey}}">
    <ToggleButton.ContentTemplate>
        <DataTemplate>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <commons:IconControl x:Name="Arrow" Grid.Column="0"
                                     IconData="{x:Static icons:IconKeys.ChevronDown}"
                                     Width="10" Height="10"
                                     HorizontalAlignment="Left" VerticalAlignment="Center"
                                     Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"/>
                <ContentPresenter Grid.Column="1" Content="{Binding}" VerticalAlignment="Center"/>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=ToggleButton}}" Value="False">
                    <Setter TargetName="Arrow" Property="commons:IconControl.IconData" Value="{x:Static icons:IconKeys.ChevronRight}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding ShowArrow, RelativeSource={RelativeSource AncestorType=local:AccordionHeader}}" Value="False">
                    <Setter TargetName="Arrow" Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </ToggleButton.ContentTemplate>
</ToggleButton>
