<UserControl x:Class="ToolBox.Items.ItemPreset.Views.ItemPresetSettingsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:YukkuriMovieMaker.Controls;assembly=YukkuriMovieMaker.Controls"
             xmlns:local="clr-namespace:ToolBox.Items.ItemPreset.Settings"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=local:ItemPresetSettings}">

    <StackPanel MinWidth="240">
        <TextBlock Text="保存したアイテムの設定" FontWeight="SemiBold" Margin="0,0,0,8"/>

        <TextBlock Text="このボタンに紐づけるアイテム"/>
        <ComboBox ItemsSource="{Binding AvailableStocks}"
                  SelectedValue="{Binding StockId, Mode=TwoWay}"
                  SelectedValuePath="Id"
                  DisplayMemberPath="DisplayLabel"
                  HorizontalAlignment="Stretch" Height="24" VerticalContentAlignment="Center"/>

        <Grid Margin="0,4,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Content="選んでいるアイテムを保存"
                    Command="{Binding SaveStockCommand}" CommandParameter="{Binding}"
                    Padding="8,3"
                    ToolTip="タイムラインで選んでいるアイテムを新しく保存して、このボタンに紐づけます"/>
            <Button Grid.Column="1" Content="上書き"
                    Command="{Binding OverwriteStockCommand}" CommandParameter="{Binding}"
                    Padding="8,3"
                    ToolTip="紐づけ先の保存内容を、今選んでいるアイテムで置き換えます"/>
        </Grid>

        <TextBlock Text="ストックの追加・名前の変更・削除は、ツールボックスの設定にある「保存したアイテム」でまとめて行えます。"
                   TextWrapping="Wrap" Margin="0,4,0,0"
                   Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"/>

        <Grid Margin="0,8,0,0">
            <TextBlock Text="今の再生位置に追加する" VerticalAlignment="Center"/>
            <controls:ToggleSlider Value="{Binding UseCurrentFrame, Mode=TwoWay}"
                                   HorizontalAlignment="Right"/>
        </Grid>

        <Grid>
            <TextBlock Text="今のレイヤーに追加する" VerticalAlignment="Center"/>
            <controls:ToggleSlider Value="{Binding UseCurrentLayer, Mode=TwoWay}"
                                   HorizontalAlignment="Right"/>
        </Grid>

        <Grid>
            <TextBlock Text="追加したアイテムを選択する" VerticalAlignment="Center"/>
            <controls:ToggleSlider Value="{Binding SelectAfterAdd, Mode=TwoWay}"
                                   HorizontalAlignment="Right"/>
        </Grid>
    </StackPanel>
</UserControl>
