<UserControl x:Class="ToolBox.Items.Macro.Views.MacroSettingsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:YukkuriMovieMaker.Controls;assembly=YukkuriMovieMaker.Controls"
             xmlns:icons="clr-namespace:YukkuriMovieMaker.Resources.Icons;assembly=YukkuriMovieMaker.Plugin"
             xmlns:theme="clr-namespace:YukkuriMovieMaker.Theme;assembly=YukkuriMovieMaker.Plugin"
             xmlns:tbCommons="clr-namespace:ToolBox.Commons"
             xmlns:tbControls="clr-namespace:ToolBox.Controls"
             xmlns:macro="clr-namespace:ToolBox.Items.Macro.Settings"
             xmlns:local="clr-namespace:ToolBox.Items.Macro.Settings"
             mc:Ignorable="d"
             x:Name="Root"
             d:DesignWidth="300"
             d:DataContext="{d:DesignInstance Type=local:MacroSettings}">

    <UserControl.Resources>
        <Style x:Key="VisibleForCommand" TargetType="FrameworkElement">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedItem.Kind, ElementName=StepList}"
                             Value="{x:Static macro:MacroStepKind.Command}">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="VisibleForShortcut" TargetType="FrameworkElement">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedItem.Kind, ElementName=StepList}"
                             Value="{x:Static macro:MacroStepKind.Shortcut}">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="VisibleForPanelItem" TargetType="FrameworkElement">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedItem.Kind, ElementName=StepList}"
                             Value="{x:Static macro:MacroStepKind.PanelItem}">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="VisibleForWait" TargetType="FrameworkElement">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedItem.Kind, ElementName=StepList}"
                             Value="{x:Static macro:MacroStepKind.Wait}">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <TextBlock Text="手順" Margin="0,0,0,4"/>

        <ListBox x:Name="StepList"
                 tbControls:ScrollBubbling.IsEnabled="True"
                 ItemsSource="{Binding Steps}"
                 BorderThickness="1"
                 BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                 HorizontalContentAlignment="Stretch"
                 MaxHeight="180" MinHeight="70"
                 Margin="0,0,0,4">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock TextTrimming="CharacterEllipsis"
                               Text="{Binding DisplayText}"/>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <Button Click="OnMoveUpClick" ToolTip="1 つ上へ"
                    Width="24" Height="24" Padding="0">
                <tbCommons:IconControl IconData="{x:Static icons:IconKeys.ArrowUpThick}"
                                       Foreground="{DynamicResource {x:Static theme:YMM4Colors.IconBrushKey}}"
                                       Width="14" Height="14"/>
            </Button>
            <Button Click="OnMoveDownClick" ToolTip="1 つ下へ"
                    Width="24" Height="24" Padding="0" Margin="4,0,0,0">
                <tbCommons:IconControl IconData="{x:Static icons:IconKeys.ArrowDownThick}"
                                       Foreground="{DynamicResource {x:Static theme:YMM4Colors.IconBrushKey}}"
                                       Width="14" Height="14"/>
            </Button>
            <Button Click="OnAddClick" ToolTip="手順を追加"
                    Width="24" Height="24" Padding="0" Margin="4,0,0,0">
                <tbCommons:IconControl IconData="{x:Static icons:IconKeys.PlusThick}"
                                       Foreground="{DynamicResource {x:Static theme:YMM4Colors.IconBrushKey}}"
                                       Width="14" Height="14"/>
            </Button>
            <Button Click="OnRemoveClick" ToolTip="選択中の手順を削除"
                    Width="24" Height="24" Padding="0" Margin="4,0,0,0">
                <tbCommons:IconControl IconData="{x:Static icons:IconKeys.Delete}"
                                       Foreground="{DynamicResource {x:Static theme:YMM4Colors.IconBrushKey}}"
                                       Width="14" Height="14"/>
            </Button>
        </StackPanel>

        <StackPanel DataContext="{Binding SelectedItem, ElementName=StepList}">
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding SelectedItem, ElementName=StepList}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>

            <Border BorderThickness="0,1,0,0" Margin="0,0,0,8"
                    BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"/>

            <TextBlock Text="選択中の手順" Margin="0,0,0,6"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*" MinWidth="90"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="種類" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox Grid.Column="1"
                          SelectedValue="{Binding Kind, Mode=TwoWay}"
                          SelectedValuePath="Tag" Height="24" VerticalContentAlignment="Center">
                    <ComboBoxItem Content="ツールボックスの操作" Tag="{x:Static macro:MacroStepKind.Command}"/>
                    <ComboBoxItem Content="ショートカット" Tag="{x:Static macro:MacroStepKind.Shortcut}"/>
                    <ComboBoxItem Content="パネル上のアイテム" Tag="{x:Static macro:MacroStepKind.PanelItem}"/>
                    <ComboBoxItem Content="待つ" Tag="{x:Static macro:MacroStepKind.Wait}"/>
                </ComboBox>
            </Grid>

            <Grid Style="{StaticResource VisibleForCommand}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*" MinWidth="90"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="操作" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox Grid.Column="1"
                          ItemsSource="{Binding AvailableCommands, ElementName=Root}"
                          DisplayMemberPath="FullDisplayName"
                          SelectedValuePath="CommandName"
                          SelectedValue="{Binding CommandName, Mode=TwoWay}" Height="24" VerticalContentAlignment="Center"/>
            </Grid>

            <Grid Margin="0,0,0,8" Style="{StaticResource VisibleForShortcut}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*" MinWidth="90"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="操作" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox Grid.Column="1"
                          ItemsSource="{Binding AvailableShortcuts, ElementName=Root}"
                          DisplayMemberPath="DisplayName"
                          SelectedValuePath="CommandType"
                          SelectedValue="{Binding ShortcutCommand, Mode=TwoWay}" Height="24" VerticalContentAlignment="Center"/>
            </Grid>

            <StackPanel Style="{StaticResource VisibleForPanelItem}" Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*" MinWidth="90"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="アイテム" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox Grid.Column="1"
                              ItemsSource="{Binding AvailablePanelItems, ElementName=Root}"
                              DisplayMemberPath="DisplayText"
                              SelectedValuePath="Id"
                              SelectedValue="{Binding PanelItemId, Mode=TwoWay}" Height="24" VerticalContentAlignment="Center"/>
                </Grid>
                <TextBlock Text="開いているパネルに置かれているアイテムを、そのアイテム自身の設定で実行します。"
                           FontSize="10" TextWrapping="Wrap" Margin="0,4,0,0"
                           Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"/>
            </StackPanel>

            <Grid Margin="0,0,0,8" Style="{StaticResource VisibleForWait}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*" MinWidth="90"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="待ち時間" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <controls:TextBoxSlider Grid.Column="1"
                                        Value="{Binding WaitMilliseconds, Mode=TwoWay}"
                                        DefaultValue="200" StringFormat="F0" Unit="ms"
                                        Min="0" Max="5000" DefaultMin="0" DefaultMax="5000" Delta="50" Height="24" VerticalContentAlignment="Center"/>
            </Grid>
        </StackPanel>

        <TextBlock Text="手順は上から順に実行されます。実行できない手順 (選択が無いなど) は飛ばして続きます。"
                   FontSize="10" TextWrapping="Wrap" Margin="0,4,0,0"
                   Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"/>
    </StackPanel>
</UserControl>
