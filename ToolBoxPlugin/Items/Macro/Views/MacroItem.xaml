<tbView:ToolItemView x:Class="ToolBox.Items.Macro.Views.MacroItem"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:tbView="clr-namespace:ToolBox.Controls"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:theme="clr-namespace:YukkuriMovieMaker.Theme;assembly=YukkuriMovieMaker.Plugin"
             xmlns:commons="clr-namespace:ToolBox.Commons"
             xmlns:local="clr-namespace:ToolBox.Items.Macro.Settings"
             mc:Ignorable="d"
             x:Name="Root"
             d:DataContext="{d:DesignInstance Type=local:MacroSettings}">

    <Button Command="{Binding RunMacroItemCommand, ElementName=Root}"
            CommandParameter="{Binding}"
            ToolTip="{Binding InstanceSummary}"
            Foreground="{DynamicResource {x:Static theme:YMM4Colors.IconBrushKey}}">
        <commons:IconControl IconData="{Binding IconPath}"
                             HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
    </Button>
</tbView:ToolItemView>
