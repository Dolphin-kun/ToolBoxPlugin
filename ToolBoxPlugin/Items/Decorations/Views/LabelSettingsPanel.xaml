<UserControl x:Class="ToolBox.Items.Decorations.Views.LabelSettingsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:YukkuriMovieMaker.Controls;assembly=YukkuriMovieMaker.Controls"
             xmlns:settings="clr-namespace:ToolBox.Settings"
             xmlns:local="clr-namespace:ToolBox.Items.Decorations.Settings"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=local:LabelSettings}">

    <UserControl.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
        <Style x:Key="FieldRow" TargetType="Grid">
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <TextBlock Text="ラベルの設定" FontWeight="SemiBold" Margin="0,0,0,8"/>

        <Grid Style="{StaticResource FieldRow}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*" MinWidth="90"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="表示する文字" Style="{StaticResource FieldLabel}"/>
            <TextBox Grid.Column="1"
                     Text="{Binding Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Height="24" VerticalContentAlignment="Center"/>
        </Grid>

        <Grid Style="{StaticResource FieldRow}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*" MinWidth="90"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="文字の大きさ" Style="{StaticResource FieldLabel}"/>
            <controls:TextBoxSlider Grid.Column="1"
                                    Value="{Binding FontSize, Mode=TwoWay}"
                                    DefaultValue="12" StringFormat="F0" Unit="px"
                                    Min="6" Max="48" DefaultMin="6" DefaultMax="48" Delta="1" Height="24" VerticalContentAlignment="Center"/>
        </Grid>

        <Grid Style="{StaticResource FieldRow}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="太字にする" Style="{StaticResource FieldLabel}"/>
            <controls:ToggleSlider Grid.Column="1"
                                   Value="{Binding IsBold, Mode=TwoWay}"
                                   HorizontalAlignment="Right"/>
        </Grid>

        <Grid Style="{StaticResource FieldRow}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*" MinWidth="90"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="文字の位置" Style="{StaticResource FieldLabel}"/>
            <ComboBox Grid.Column="1"
                      SelectedValue="{Binding TextAlignment, Mode=TwoWay}"
                      SelectedValuePath="Tag" Height="24" VerticalContentAlignment="Center">
                <ComboBoxItem Content="左寄せ" Tag="{x:Static settings:ItemTextAlignment.Left}"/>
                <ComboBoxItem Content="中央" Tag="{x:Static settings:ItemTextAlignment.Center}"/>
                <ComboBoxItem Content="右寄せ" Tag="{x:Static settings:ItemTextAlignment.Right}"/>
            </ComboBox>
        </Grid>
    </StackPanel>
</UserControl>
