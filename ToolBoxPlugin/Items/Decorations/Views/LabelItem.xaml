<tbView:ToolItemView x:Class="ToolBox.Items.Decorations.Views.LabelItem"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:tbView="clr-namespace:ToolBox.Controls"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:settings="clr-namespace:ToolBox.Settings"
             xmlns:local="clr-namespace:ToolBox.Items.Decorations.Settings"
             mc:Ignorable="d"
             x:Name="Root"
             d:DataContext="{d:DesignInstance Type=local:LabelSettings}"
             ToolTip="{Binding Text}">

    <Grid Background="Transparent">
        <TextBlock Text="{Binding Text}"
                   FontSize="{Binding FontSize}"
                   TextTrimming="CharacterEllipsis"
                   TextWrapping="Wrap"
                   VerticalAlignment="Center"
                   Margin="4,0">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="HorizontalAlignment" Value="Left"/>
                    <Setter Property="FontWeight" Value="Normal"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasCustomFont}" Value="True">
                            <Setter Property="FontFamily" Value="{Binding TextFontFamily}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsBold}" Value="True">
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding TextAlignment}" Value="{x:Static settings:ItemTextAlignment.Center}">
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding TextAlignment}" Value="{x:Static settings:ItemTextAlignment.Right}">
                            <Setter Property="HorizontalAlignment" Value="Right"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding UseCustomAppearance}" Value="True">
                            <Setter Property="Foreground" Value="{Binding AppearanceForeground}"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
    </Grid>
</tbView:ToolItemView>
