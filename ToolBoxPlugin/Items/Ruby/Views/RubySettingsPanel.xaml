<UserControl x:Class="ToolBox.Items.Ruby.Views.RubySettingsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:tbRow="clr-namespace:ToolBox.Controls"
             xmlns:toolbox="clr-namespace:ToolBox"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:YukkuriMovieMaker.Controls;assembly=YukkuriMovieMaker.Controls"
             xmlns:local="clr-namespace:ToolBox.Items.Ruby.Settings"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=local:RubySettings}">

    <StackPanel>
        <TextBlock Text="{x:Static toolbox:Texts.RubySettingsTitle}" FontWeight="SemiBold" Margin="0,0,0,8" />

        <tbRow:SettingsRow Label="{x:Static toolbox:Texts.RubyTypeLabel}">
            <controls:EnumComboBox Value="{Binding RubyType, Mode=TwoWay}" EnumType="{x:Type local:RubyType}" Width="120" HorizontalAlignment="Right" Height="24" VerticalContentAlignment="Center"/>
        </tbRow:SettingsRow>

        <tbRow:SettingsRow Label="{x:Static toolbox:Texts.RubyAutoLineHeight}">
            <controls:ToggleSlider Value="{Binding IsAutoAdjustLineHeight, Mode=TwoWay}" HorizontalAlignment="Right"/>
        </tbRow:SettingsRow>

        <Grid Margin="0,0,0,4">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsAutoAdjustLineHeight}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <StackPanel Orientation="Vertical" HorizontalAlignment="Stretch">
                <TextBlock Text="{x:Static toolbox:Texts.RubyLineHeightScale}" Margin="0,0,0,2"/>
                <controls:TextBoxSlider Value="{Binding LineHeightMultiplier, Mode=TwoWay}"
                                        DefaultValue="1.5"
                                        StringFormat="F1"
                                        Unit="{x:Static toolbox:Texts.UnitTimes}"
                                        DefaultMin="1.0" DefaultMax="3.0"
                                        Min="0.1" Max="10.0"
                                        HorizontalAlignment="Stretch" Height="24" VerticalContentAlignment="Center"/>
            </StackPanel>
        </Grid>
    </StackPanel>
</UserControl>
