<tbControls:ToolItemView x:Class="ToolBox.Items.Shortcuts.Views.ShortcutItem"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:theme="clr-namespace:YukkuriMovieMaker.Theme;assembly=YukkuriMovieMaker.Plugin"
             xmlns:commons="clr-namespace:ToolBox.Commons"
             xmlns:tbControls="clr-namespace:ToolBox.Controls"
             xmlns:settings="clr-namespace:ToolBox.Settings"
             mc:Ignorable="d"
             x:Name="Root">

    <Button Command="{Binding ShortcutCommand, ElementName=Root}" CommandParameter="{Binding}" ToolTip="{Binding Label}">
        <Grid HorizontalAlignment="Center" VerticalAlignment="Center" ClipToBounds="True">
            <commons:IconControl IconData="{Binding IconPath}"
                  Foreground="{DynamicResource {x:Static theme:YMM4Colors.IconBrushKey}}"
                  HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <commons:IconControl.Style>
                    <Style TargetType="commons:IconControl">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding DisplayMode}" Value="{x:Static settings:ToolItemDisplayMode.Icon}">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </commons:IconControl.Style>
            </commons:IconControl>

            <tbControls:AnimatedImage SourcePath="{Binding CustomImagePath}"
                   HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Stretch="{Binding ImageStretch}">
                <tbControls:AnimatedImage.Style>
                    <Style TargetType="tbControls:AnimatedImage">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding DisplayMode}" Value="{x:Static settings:ToolItemDisplayMode.Image}">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </tbControls:AnimatedImage.Style>
            </tbControls:AnimatedImage>

            <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding DisplayMode}" Value="{x:Static settings:ToolItemDisplayMode.Text}">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>
    </Button>
</tbControls:ToolItemView>
