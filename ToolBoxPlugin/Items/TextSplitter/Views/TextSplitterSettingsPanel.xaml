<UserControl x:Class="ToolBox.Items.TextSplitter.Views.TextSplitterSettingsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:tbRow="clr-namespace:ToolBox.Controls"
             xmlns:toolbox="clr-namespace:ToolBox"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:YukkuriMovieMaker.Controls;assembly=YukkuriMovieMaker.Controls"
             xmlns:local="clr-namespace:ToolBox.Items.TextSplitter.Settings"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=local:TextSplitterSettings}">

    <StackPanel>
        <TextBlock Text="{x:Static toolbox:Texts.TextSplitterSettingsTitle}" FontWeight="SemiBold" Margin="0,0,0,8" />

        <tbRow:SettingsRow Label="{x:Static toolbox:Texts.TextSplitterDeleteOriginal}">
            <controls:ToggleSlider Value="{Binding IsDeleteOriginalItem, Mode=TwoWay}" HorizontalAlignment="Right"/>
        </tbRow:SettingsRow>

        <tbRow:SettingsRow Label="{x:Static toolbox:Texts.TextSplitterModeLabel}">
            <controls:EnumComboBox Value="{Binding SplitMode, Mode=TwoWay}" EnumType="{x:Type local:SplitMode}" Width="120" HorizontalAlignment="Right" Height="24" VerticalContentAlignment="Center"/>
        </tbRow:SettingsRow>

        <tbRow:SettingsRow Label="{x:Static toolbox:Texts.TextSplitterDirectionLabel}" Margin="0,0,0,6">
            <controls:EnumComboBox Value="{Binding SplitDirection, Mode=TwoWay}" EnumType="{x:Type local:SplitDirection}" Width="120" HorizontalAlignment="Right" Height="24" VerticalContentAlignment="Center"/>
        </tbRow:SettingsRow>

        <Border BorderThickness="0,1,0,0" BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}" Margin="0,4,0,8" />

        <tbRow:SettingsRow Label="{x:Static toolbox:Texts.TextSplitterKeepPosition}">
            <controls:ToggleSlider Value="{Binding IsKeepPosition, Mode=TwoWay}" HorizontalAlignment="Right"/>
        </tbRow:SettingsRow>

        <Grid Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{x:Static toolbox:Texts.TextSplitterIgnoreTags}" VerticalAlignment="Center" ToolTip="{x:Static toolbox:Texts.TextSplitterIgnoreTagsTip}"/>
            <controls:ToggleSlider Grid.Column="1" Value="{Binding IsIgnoreTags, Mode=TwoWay}" HorizontalAlignment="Right"/>
        </Grid>

        <Border BorderThickness="0,1,0,0" BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}" Margin="0,4,0,8" />

        <Grid>
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding SplitDirection}" Value="{x:Static local:SplitDirection.Vertical}">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <StackPanel Orientation="Vertical" HorizontalAlignment="Stretch">
                <TextBlock Text="{x:Static toolbox:Texts.TextSplitterOffsetLabel}" Margin="0,0,0,2"/>
                <controls:TextBoxSlider Value="{Binding FrameOffset, Mode=TwoWay}"
                                        DefaultValue="0"
                                        StringFormat="F0"
                                        Unit="F"
                                        DefaultMin="0" DefaultMax="300"
                                        Min="0" Max="2147483647"
                                        HorizontalAlignment="Stretch" Height="24" VerticalContentAlignment="Center"/>
            </StackPanel>
        </Grid>

        <Grid Margin="0,0,0,4">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding SplitDirection}" Value="{x:Static local:SplitDirection.Horizontal}">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid>
                <TextBlock Text="{x:Static toolbox:Texts.TextSplitterKeepDuration}" VerticalAlignment="Center"/>
                <controls:ToggleSlider Value="{Binding IsKeepLength, Mode=TwoWay}" HorizontalAlignment="Right"/>
            </Grid>
        </Grid>
    </StackPanel>
</UserControl>
