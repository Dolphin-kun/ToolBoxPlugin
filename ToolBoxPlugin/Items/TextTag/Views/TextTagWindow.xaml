<Window x:Class="ToolBox.Items.TextTag.Views.TextTagWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:tbRow="clr-namespace:ToolBox.Controls"
        xmlns:toolbox="clr-namespace:ToolBox"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:commons="clr-namespace:ToolBox.Commons"
        xmlns:views="clr-namespace:ToolBox.Items.TextTag.Views"
        mc:Ignorable="d"
        Title="{x:Static toolbox:Texts.TextTagWindowTitle}"
        Width="720" Height="560"
        MinWidth="560" MinHeight="440"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}">

    <Window.Resources>
        <DataTemplate x:Key="TagButtonTemplate" DataType="{x:Type views:TextTagButton}">
            <Button Width="96" Height="60" Margin="0,0,6,6"
                    Focusable="False"
                    IsEnabled="{Binding IsEnabled}"
                    ToolTip="{Binding Sample}"
                    Click="OnTagButtonClick"
                    Tag="{Binding}">
                <StackPanel>
                    <commons:IconControl IconData="{Binding IconPath}" Width="20" Height="20"
                                         HorizontalAlignment="Center" Margin="0,0,0,4"
                                         Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                    <TextBlock Text="{Binding Label}" FontSize="11" TextAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Button>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*" MinHeight="90"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <tbRow:SettingsRow Label="{x:Static toolbox:Texts.TextTagTargetLabel}" Grid.Row="0" Margin="0,0,0,8">
            <ComboBox x:Name="TargetSelector"
            ItemsSource="{Binding Targets}"
            SelectedItem="{Binding SelectedTarget, Mode=TwoWay}"
            DisplayMemberPath="Caption"
            Height="24" VerticalContentAlignment="Center"/>
        </tbRow:SettingsRow>

        <TextBox Grid.Row="1" x:Name="SourceBox"
                 AcceptsReturn="True" TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"
                 IsInactiveSelectionHighlightEnabled="True"
                 IsUndoEnabled="True" UndoLimit="200"
                 FontFamily="Consolas" FontSize="13"
                 TextChanged="OnTextChanged"
                 SelectionChanged="OnSelectionChanged"/>

        <TextBlock Grid.Row="2" FontSize="10" TextWrapping="Wrap" Margin="0,6,0,0"
                   Text="{x:Static toolbox:Texts.TextTagLiveNotice}"
                   Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"/>

        <StackPanel Grid.Row="3" Margin="0,8,0,0">
            <TabControl x:Name="Tabs" Height="230">
                <TabItem Header="{x:Static toolbox:Texts.TextTagRangeTab}">
                    <StackPanel Margin="6">
                        <TextBlock x:Name="RangeHint" FontSize="10" Margin="0,0,0,6"
                                   Text="{x:Static toolbox:Texts.TextTagRangeHint}"
                                   Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"/>
                        <ItemsControl ItemsSource="{Binding RangeButtons}"
                                      ItemTemplate="{StaticResource TagButtonTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </StackPanel>
                </TabItem>

                <TabItem Header="{x:Static toolbox:Texts.TextTagInsertTab}">
                    <StackPanel Margin="6">
                        <TextBlock FontSize="10" Margin="0,0,0,6"
                                   Text="{x:Static toolbox:Texts.TextTagInsertHint}"
                                   Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"/>
                        <ItemsControl ItemsSource="{Binding InsertButtons}"
                                      ItemTemplate="{StaticResource TagButtonTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </StackPanel>
                </TabItem>
            </TabControl>

            <Grid Margin="0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <Button x:Name="UndoButton" Content="{x:Static toolbox:Texts.TextTagUndo}"
                            Width="90" Padding="0,4" Margin="0"
                            ToolTip="{x:Static toolbox:Texts.TextTagUndoTip}"
                            Focusable="False" Click="OnUndoClick"/>
                    <Button Content="{x:Static toolbox:Texts.TextTagRevert}"
                            Width="110" Padding="0,4"
                            Focusable="False" Click="OnRevertClick"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="{x:Static toolbox:Texts.TextTagCommit}" Width="90" Padding="0,4"
                            IsDefault="True" Click="OnCommitClick"/>
                    <Button Content="{x:Static toolbox:Texts.CommonCancel}" Width="90" Padding="0,4"
                            IsCancel="True"/>
                </StackPanel>
            </Grid>
        </StackPanel>

        <Popup x:Name="ParameterPopup" Placement="Mouse" StaysOpen="False" AllowsTransparency="True">
            <Border BorderThickness="1" Padding="10" MinWidth="280"
                    BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                    Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}">
                <StackPanel>
                    <TextBlock x:Name="PopupTitle" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <StackPanel x:Name="PopupFields"/>
                    <TextBlock x:Name="PopupPreview" FontFamily="Consolas" FontSize="11" Margin="0,6,0,0"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                        <Button Content="{x:Static toolbox:Texts.TextTagInsertButton}" Width="80" Padding="0,4"
                                Click="OnPopupApplyClick"/>
                        <Button Content="{x:Static toolbox:Texts.CommonCancel}" Width="80" Padding="0,4"
                                Click="OnPopupCancelClick"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</Window>
