<UserControl x:Class="ToolBox.Items.Bookmarks.Views.BookmarkSettingsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:toolbox="clr-namespace:ToolBox"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:icons="clr-namespace:YukkuriMovieMaker.Resources.Icons;assembly=YukkuriMovieMaker.Plugin"
             xmlns:commons="clr-namespace:ToolBox.Commons"
             xmlns:setting="clr-namespace:ToolBox.Items.Bookmarks.Settings"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=setting:BookmarkSettings}">

    <StackPanel MinWidth="240">
        <TextBlock Text="{x:Static toolbox:Texts.BookmarkSettingsTitle}" FontWeight="SemiBold" Margin="0,0,0,6"/>

        <TextBlock Text="{x:Static toolbox:Texts.BookmarkEmpty}"
                   FontSize="10" Margin="0,0,0,6"
                   Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasBookmarks}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding Bookmarks}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type setting:BookmarkEntry}">
                        <Grid Margin="0,0,0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="{Binding TimeText}"
                                       VerticalAlignment="Center" Margin="0,0,6,0"
                                       FontFamily="Consolas"/>

                            <TextBox Grid.Column="1" Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Height="24" VerticalContentAlignment="Center"/>

                            <Button Grid.Column="2" Width="24" Height="24" Margin="4,0,0,0"
                                    ToolTip="{x:Static toolbox:Texts.BookmarkJump}"
                                    Command="{Binding DataContext.JumpCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}">
                                <commons:IconControl IconData="{x:Static icons:IconKeys.ArrowRight}" Width="12" Height="12"/>
                            </Button>

                            <Button Grid.Column="3" Width="24" Height="24" Margin="2,0,0,0"
                                    ToolTip="{x:Static toolbox:Texts.BookmarkRemove}"
                                    Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}">
                                <commons:IconControl IconData="{x:Static icons:IconKeys.Close}" Width="12" Height="12"/>
                            </Button>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
            <Button Content="{x:Static toolbox:Texts.BookmarkToggleCommandName}"
                    Command="{Binding ToggleCommand}" Padding="8,3"/>
            <Button Content="{x:Static toolbox:Texts.BookmarkClearCommandName}"
                    Command="{Binding ClearCommand}" Padding="8,3" Margin="4,0,0,0"/>
        </StackPanel>
    </StackPanel>
</UserControl>
