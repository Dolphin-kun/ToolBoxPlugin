<UserControl x:Class="ToolBox.Items.SceneMover.Views.SceneMoverSettingsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:YukkuriMovieMaker.Controls;assembly=YukkuriMovieMaker.Controls"
             xmlns:local="clr-namespace:ToolBox.Items.SceneMover.Settings"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=local:SceneMoverSettings}">

    <StackPanel>
        <TextBlock Text="シーンへ移動の設定" FontWeight="SemiBold" Margin="0,0,0,8"/>

        <Grid>
            <TextBlock Text="移動せずに複製する" VerticalAlignment="Center"/>
            <controls:ToggleSlider Value="{Binding DuplicateInsteadOfMove, Mode=TwoWay}"
                                   HorizontalAlignment="Right"/>
        </Grid>

        <Grid>
            <TextBlock Text="シーンの先頭に詰める" VerticalAlignment="Center"/>
            <controls:ToggleSlider Value="{Binding AlignToSceneStart, Mode=TwoWay}"
                                   HorizontalAlignment="Right"/>
        </Grid>

        <Grid>
            <TextBlock Text="移動先のシーンに切り替える" VerticalAlignment="Center"/>
            <controls:ToggleSlider Value="{Binding SwitchToTargetScene, Mode=TwoWay}"
                                   HorizontalAlignment="Right"/>
        </Grid>

        <Button Content="新しいシーンへ移動"
                Click="OnMoveToNewScene"
                HorizontalAlignment="Right" Padding="12,3" Margin="0,8,0,0"
                ToolTip="タイムラインで選んでいるアイテムを、新しいシーンへ移します"/>
    </StackPanel>
</UserControl>
