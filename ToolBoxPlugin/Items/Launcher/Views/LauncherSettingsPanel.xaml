<UserControl x:Class="ToolBox.Items.Launcher.Views.LauncherSettingsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:YukkuriMovieMaker.Controls;assembly=YukkuriMovieMaker.Controls"
             xmlns:local="clr-namespace:ToolBox.Items.Launcher.Settings"
             mc:Ignorable="d"
             d:DesignWidth="300"
             d:DataContext="{d:DesignInstance Type=local:LauncherSettings}">

    <StackPanel>
        <TextBlock Text="開く対象" FontSize="11" Margin="0,0,0,4"/>

        <controls:FileSelector Value="{Binding TargetPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                               Filter="すべてのファイル|*.*"
                               AllowEmptyFilePath="True"
                               Height="24" FontSize="11"
                               Margin="0,0,0,4"/>

        <Button Content="フォルダーを選ぶ..." Click="OnBrowseFolderClick"
                HorizontalAlignment="Left" Padding="8,3" FontSize="11"
                Margin="0,0,0,6"/>
    </StackPanel>
</UserControl>
