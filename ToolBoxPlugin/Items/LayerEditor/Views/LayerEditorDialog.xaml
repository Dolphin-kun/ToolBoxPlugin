<Window x:Class="ToolBox.Items.LayerEditor.Views.LayerEditorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:toolbox="clr-namespace:ToolBox"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:controls="clr-namespace:YukkuriMovieMaker.Controls;assembly=YukkuriMovieMaker.Controls"
        xmlns:icons="clr-namespace:YukkuriMovieMaker.Resources.Icons;assembly=YukkuriMovieMaker.Plugin"
        xmlns:commons="clr-namespace:ToolBox.Commons"
        xmlns:setting="clr-namespace:ToolBox.Items.LayerEditor.Settings"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=setting:LayerEditorSettings}"
        Title="{x:Static toolbox:Texts.LayerEditorDialogTitle}"
        Width="360"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}">

    <Window.Resources>
        <Style x:Key="VisibleWhenRange" TargetType="Grid">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Scope}" Value="{x:Static setting:LayerTargetScope.Range}">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="FieldRow" TargetType="Grid">
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
    </Window.Resources>

    <StackPanel Margin="12">
        <Grid Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{x:Static toolbox:Texts.LayerEditorScopeLabel}" VerticalAlignment="Center"/>
            <ComboBox Grid.Column="1" SelectedValue="{Binding Scope, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                      SelectedValuePath="Tag" Height="24" VerticalContentAlignment="Center">
                <ComboBoxItem Content="{x:Static toolbox:Texts.LayerEditorScopeSelected}" Tag="{x:Static setting:LayerTargetScope.SelectedLayers}"/>
                <ComboBoxItem Content="{x:Static toolbox:Texts.LayerEditorScopeRange}" Tag="{x:Static setting:LayerTargetScope.Range}"/>
            </ComboBox>
        </Grid>

        <Grid Style="{StaticResource VisibleWhenRange}" Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{x:Static toolbox:Texts.LayerEditorFromLabel}" VerticalAlignment="Center"/>
            <controls:TextBoxSlider Grid.Column="1" Value="{Binding FromLayer, Mode=TwoWay}"
                                    DefaultValue="0" StringFormat="F0" IsUnitVisible="False"
                                    Min="0" Max="99" DefaultMin="0" DefaultMax="20" Delta="1"
                                    Height="24" VerticalContentAlignment="Center"/>
        </Grid>

        <Grid Style="{StaticResource VisibleWhenRange}" Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{x:Static toolbox:Texts.LayerEditorToLabel}" VerticalAlignment="Center"/>
            <controls:TextBoxSlider Grid.Column="1" Value="{Binding ToLayer, Mode=TwoWay}"
                                    DefaultValue="5" StringFormat="F0" IsUnitVisible="False"
                                    Min="0" Max="99" DefaultMin="0" DefaultMax="20" Delta="1"
                                    Height="24" VerticalContentAlignment="Center"/>
        </Grid>

        <Border Height="1" Margin="0,4,0,10"
                Background="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"/>

        <Grid Style="{StaticResource FieldRow}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <CheckBox Grid.Column="0" VerticalAlignment="Center"
                      IsChecked="{Binding ChangeEnabled, Mode=TwoWay}"
                      Content="{x:Static toolbox:Texts.LayerEditorEnabledLabel}"/>
            <controls:ToggleSlider Grid.Column="1" HorizontalAlignment="Left"
                                   Value="{Binding IsLayerEnabled, Mode=TwoWay}"
                                   IsEnabled="{Binding ChangeEnabled}"/>
        </Grid>

        <Grid Style="{StaticResource FieldRow}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <CheckBox Grid.Column="0" VerticalAlignment="Center"
                      IsChecked="{Binding ChangeLabel, Mode=TwoWay}"
                      Content="{x:Static toolbox:Texts.LayerEditorNameLabel}"/>
            <TextBox Grid.Column="1" Height="24" VerticalContentAlignment="Center"
                     Text="{Binding LabelTemplate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     IsEnabled="{Binding ChangeLabel}"/>
        </Grid>

        <TextBlock Text="{x:Static toolbox:Texts.LayerEditorNameHint}"
                   FontSize="10" TextWrapping="Wrap" Margin="110,0,0,8"
                   Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"/>

        <Grid Style="{StaticResource FieldRow}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <CheckBox Grid.Column="0" VerticalAlignment="Center"
                      IsChecked="{Binding ChangeColor, Mode=TwoWay}"
                      Content="{x:Static toolbox:Texts.LayerEditorColorLabel}"/>
            <controls:ColorPicker Grid.Column="1" Height="24" VerticalContentAlignment="Center"
                                  Value="{Binding LayerColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  IsEnabled="{Binding ChangeColor}"/>
            <Button Grid.Column="2" Width="24" Height="24"
                    Click="OnClearColorClick"
                    IsEnabled="{Binding ChangeColor}"
                    ToolTip="{x:Static toolbox:Texts.LayerEditorColorClearTip}">
                <commons:IconControl IconData="{x:Static icons:IconKeys.Backspace}" Width="12" Height="12"/>
            </Button>
        </Grid>

        <Grid Style="{StaticResource FieldRow}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <CheckBox Grid.Column="0" VerticalAlignment="Center"
                      IsChecked="{Binding ChangeVolume, Mode=TwoWay}"
                      Content="{x:Static toolbox:Texts.LayerEditorVolumeLabel}"/>
            <controls:TextBoxSlider Grid.Column="1" Value="{Binding LayerVolume, Mode=TwoWay}"
                                    DefaultValue="100" StringFormat="F1" Unit="%"
                                    Min="0" Max="200" DefaultMin="0" DefaultMax="200" Delta="1"
                                    Height="24" VerticalContentAlignment="Center"
                                    IsEnabled="{Binding ChangeVolume}"/>
        </Grid>

        <Grid Margin="0,10,0,0">
            <Button Content="{x:Static toolbox:Texts.LayerEditorResetCommandName}"
                    HorizontalAlignment="Left" Width="90" Padding="0,4"
                    Click="OnResetClick"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{x:Static toolbox:Texts.LayerEditorApplyCommandName}" Width="80" Padding="0,4"
                        IsDefault="True" Click="OnApplyClick"/>
                <Button Content="{x:Static toolbox:Texts.CommonCancel}" Width="80" Padding="0,4"
                        IsCancel="True"/>
            </StackPanel>
        </Grid>
    </StackPanel>
</Window>
