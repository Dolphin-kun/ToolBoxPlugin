<tbView:ToolItemView x:Class="ToolBox.Items.LayerEditor.Views.LayerEditorItem"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:tbView="clr-namespace:ToolBox.Controls"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:theme="clr-namespace:YukkuriMovieMaker.Theme;assembly=YukkuriMovieMaker.Plugin"
             xmlns:icons="clr-namespace:YukkuriMovieMaker.Resources.Icons;assembly=YukkuriMovieMaker.Plugin"
             xmlns:commons="clr-namespace:ToolBox.Commons"
             mc:Ignorable="d"
             x:Name="Root"
             ToolTip="{Binding DisplayName}">

    <Button Command="{Binding LayerEditorApplyCommand, ElementName=Root}"
            Foreground="{DynamicResource {x:Static theme:YMM4Colors.IconBrushKey}}">
        <commons:IconControl IconData="{x:Static icons:IconKeys.LabelMultiple}"/>
    </Button>
</tbView:ToolItemView>
