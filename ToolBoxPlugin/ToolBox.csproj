<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<UseWPF>true</UseWPF>

		<Version>3.0.0</Version>

		<!--Pdb内にソースコードのフルパスを含めない-->
		<RepoRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\'))</RepoRoot>
		<PathMap>$(RepoRoot)=.</PathMap>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\YukkuriMovieMaker.Generator\YukkuriMovieMaker.Generator\YukkuriMovieMaker.Generator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
		<AdditionalFiles Include="**/*.csv" />
	</ItemGroup>

	<ItemGroup>
		<Reference Include="NAudio">
		  <HintPath>$(YMM4DirPath)NAudio.dll</HintPath>
		</Reference>
		<Reference Include="NAudio.Core">
		  <HintPath>$(YMM4DirPath)NAudio.Core.dll</HintPath>
		</Reference>
		<Reference Include="NAudio.WinMM">
		  <HintPath>$(YMM4DirPath)NAudio.WinMM.dll</HintPath>
		</Reference>
		<Reference Include="Newtonsoft.Json">
			<HintPath>$(YMM4DirPath)Newtonsoft.Json.dll</HintPath>
		</Reference>
		<Reference Include="YukkuriMovieMaker">
			<HintPath>$(YMM4DirPath)YukkuriMovieMaker.dll</HintPath>
		</Reference>
		<Reference Include="YukkuriMovieMaker.Controls">
			<HintPath>$(YMM4DirPath)YukkuriMovieMaker.Controls.dll</HintPath>
		</Reference>
		<Reference Include="YukkuriMovieMaker.Plugin">
			<HintPath>$(YMM4DirPath)YukkuriMovieMaker.Plugin.dll</HintPath>
		</Reference>
	</ItemGroup>

	<!--ビルド後にYMM4のプラグインフォルダにdllと言語別リソースをコピーする-->
	<Target Name="PostBuild" AfterTargets="PostBuildEvent">
		<PropertyGroup>
			<PluginOutputDir>$(YMM4DirPath)user\plugin\$(ProjectName)\</PluginOutputDir>
		</PropertyGroup>
		<ItemGroup>
			<SatelliteAssemblyOutput Include="$(TargetDir)**\$(TargetName).resources.dll" />
		</ItemGroup>
		<MakeDir Directories="$(PluginOutputDir)" />
		<Copy SourceFiles="$(TargetPath)"
			  DestinationFolder="$(PluginOutputDir)"
			  ContinueOnError="WarnAndContinue" />
		<Copy SourceFiles="@(SatelliteAssemblyOutput)"
			  DestinationFiles="@(SatelliteAssemblyOutput->'$(PluginOutputDir)%(RecursiveDir)%(Filename)%(Extension)')"
			  ContinueOnError="WarnAndContinue" />
	</Target>
</Project>