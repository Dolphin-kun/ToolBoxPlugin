<UserControl x:Class="SampleAddon.Views.SampleHelloItemView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:theme="clr-namespace:YukkuriMovieMaker.Theme;assembly=YukkuriMovieMaker.Plugin"
             xmlns:icons="clr-namespace:YukkuriMovieMaker.Resources.Icons;assembly=YukkuriMovieMaker.Plugin"
             xmlns:commons="clr-namespace:ToolBox.Commons;assembly=ToolBox"
             mc:Ignorable="d"
             x:Name="Root"
             ToolTip="{Binding DisplayName}">

    <Button Command="{Binding ShowMessageItemCommand, ElementName=Root}" ToolTip="メッセージを表示"
            Foreground="{DynamicResource {x:Static theme:YMM4Colors.IconBrushKey}}">
        <commons:IconControl IconData="{x:Static icons:IconKeys.MessageTextOutline}" VerticalAlignment="Stretch" HorizontalAlignment="Stretch"/>
    </Button>
</UserControl>
